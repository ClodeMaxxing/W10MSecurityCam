<Page
    x:Class="W10MSecurityCam.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">
    <Page.Resources>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="#0B1A10" />
            <Setter Property="BorderBrush" Value="#16301E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,3,5,4" />
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="60" />
            <Setter Property="Foreground" Value="#6F8F77" />
        </Style>
        <Style x:Key="TileBig" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#D6E8D9" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- The recording light: a slow fade while streaming (as the W10MDashcam REC light). -->
        <Storyboard x:Name="DotPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="StatusDot" Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:1.2" />
        </Storyboard>
        <Style x:Key="FoldButton" TargetType="Button">
            <Setter Property="Background" Value="#0B1A10" />
            <Setter Property="BorderThickness" Value="3,0,0,1" />
            <Setter Property="BorderBrush" Value="#3FBF5F" />
            <Setter Property="Foreground" Value="#9CF0B0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,9,10,9" />
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <!-- Plain action buttons: dark green with a soft green edge. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#123320" />
            <Setter Property="Foreground" Value="#CFFFD8" />
            <Setter Property="BorderBrush" Value="#2E7D46" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- Service pills under the start button: one line per transport (W10MSecurityCam and W10MWebCam). -->
        <Style x:Key="ServicePill" TargetType="Border">
            <Setter Property="Background" Value="#0B1A10" />
            <Setter Property="BorderBrush" Value="#2E7D46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2,9,3" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <!-- A full-width button with a short light on its left edge: green while the thing is on, dark while off
             (the stream, Preview, Screensaver, Flashlight; the same in W10MDashcam / W10MWebCam). The code sets the light and
             the state text. The content grid's first column is the BarLight border. -->
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#0A160D" />
            <Setter Property="BorderBrush" Value="#1F3A26" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0,7,10,7" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="BarName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#D8F5DC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BarState" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="#7FAE86" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="BarLight" TargetType="Border">
            <Setter Property="Width" Value="4" />
            <Setter Property="CornerRadius" Value="0,2,2,0" />
            <Setter Property="Background" Value="#16301E" />
            <Setter Property="Margin" Value="0,1,10,1" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <!-- A group of service rows (RTSP, WEB UI) with a small label on top. -->
        <Style x:Key="ServiceGroup" TargetType="Border">
            <Setter Property="Background" Value="#07140B" />
            <Setter Property="BorderBrush" Value="#1F3A26" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,4,6,2" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="ServiceGroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="CharacterSpacing" Value="80" />
            <Setter Property="Foreground" Value="#7FAE86" />
            <Setter Property="Margin" Value="2,0,0,3" />
        </Style>
        <Style x:Key="PillLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#8FB596" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="36" />
        </Style>
        <Style x:Key="PillDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="#555555" />
        </Style>
        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#9CF0B0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A small (i) at the top right of a setting: its explanation opens in a pop-up instead of taking space (as in W10MDashcam / W10MWebCam). -->
        <Style x:Key="InfoButton" TargetType="Button">
            <Setter Property="Content" Value="&#x24D8;" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="#3FBF5F" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,0,2,2" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="InfoText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="300" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>

        <CaptureElement x:Name="PreviewElement" Stretch="Uniform" />
        <!-- The dark preview area: a tap shows the picture for 60 s, like Show camera picture (MainPage.Display.cs). -->
        <Grid x:Name="PreviewTapArea" Background="Transparent" Tapped="PreviewArea_Tapped">
            <TextBlock x:Name="PreviewOffText" Text="Preview off" Foreground="#6F8F77" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="12" />
        </Grid>

        <ScrollViewer Grid.Column="1" Background="#050805" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,6,10,10">
                <!-- MAIN: what is needed day to day. Everything else folds away below. -->
                <!-- Status card, first: the app name as its top band, then its header row (recording light, state, resolution,
                     viewers), which is the button that starts and stops the stream (StartButton; UpdateStatusCard /
                     UpdateStreamButton), then the big numbers and the tiles. -->
                <Border Background="#07140B" BorderBrush="#1F3A26" BorderThickness="1" CornerRadius="6" Padding="10,0,10,8" Margin="0,0,0,6">
                    <StackPanel>
                        <Grid Margin="-10,0,-10,0" Padding="10,6,10,5" Background="#050A06" BorderBrush="#1F3A26" BorderThickness="0,0,0,1">
                            <TextBlock x:Name="TitleText" Text="W10MSecurityCam" FontSize="20" FontWeight="SemiBold" Foreground="#E4F5E7" VerticalAlignment="Bottom" />
                            <TextBlock x:Name="VersionText" Text="" FontSize="11" FontWeight="Bold" Foreground="#39FF14" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                        <Button x:Name="StartButton" Style="{StaticResource BarButton}" Margin="-10,0,-10,4" Padding="0,12,10,12" BorderThickness="0,0,0,1" Click="StartButton_Click" IsEnabled="False">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border x:Name="StreamBar" Style="{StaticResource BarLight}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#3A1414" Stroke="#5A2020" StrokeThickness="1" VerticalAlignment="Center" Margin="0,0,9,0" />
                                    <TextBlock x:Name="StateText" Text="STOPPED" FontSize="15" FontWeight="SemiBold" Foreground="#9CF0B0" CharacterSpacing="80" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <!-- The stream's own numbers: four tiles above the phone tiles (UpdateStatusCard). -->
                        <Grid Margin="-2,2,-2,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Tile}" BorderBrush="#1F3A26">
                                <StackPanel><TextBlock Text="FPS" Style="{StaticResource TileLabel}" /><TextBlock x:Name="FpsTileText" Text="-" Style="{StaticResource TileBig}" /></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Tile}" BorderBrush="#1F3A26">
                                <StackPanel><TextBlock Text="MBPS" Style="{StaticResource TileLabel}" /><TextBlock x:Name="MbpsTileText" Text="-" Style="{StaticResource TileBig}" /></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Tile}" BorderBrush="#1F3A26">
                                <StackPanel><TextBlock Text="FORMAT" Style="{StaticResource TileLabel}" /><TextBlock x:Name="ResText" Text="-" Style="{StaticResource TileBig}" /></StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource Tile}" BorderBrush="#1F3A26">
                                <StackPanel><TextBlock Text="VIEWERS" Style="{StaticResource TileLabel}" /><TextBlock x:Name="ViewersText" Text="-" Style="{StaticResource TileBig}" /></StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="-2,2,-2,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="BATTERY" Style="{StaticResource TileLabel}" />
                                    <TextBlock x:Name="BattText" Text="-" Style="{StaticResource TileValue}" />
                                    <Grid x:Name="BattBar" Height="6" Margin="0,3,0,0" Background="#06100A" BorderBrush="#1F3A26" BorderThickness="1" CornerRadius="3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="0*" /><ColumnDefinition Width="100*" /></Grid.ColumnDefinitions>
                                        <Border x:Name="BattBarFill" Background="#39FF14" CornerRadius="2" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="WI-FI" Style="{StaticResource TileLabel}" />
                                    <TextBlock x:Name="WifiText" Text="-" Style="{StaticResource TileValue}" />
                                    <StackPanel Orientation="Horizontal" Height="12" Margin="0,3,0,0">
                                        <Rectangle x:Name="Wifi1" Width="5" Height="3" Margin="0,0,2,0" VerticalAlignment="Bottom" Fill="#16301E" />
                                        <Rectangle x:Name="Wifi2" Width="5" Height="6" Margin="0,0,2,0" VerticalAlignment="Bottom" Fill="#16301E" />
                                        <Rectangle x:Name="Wifi3" Width="5" Height="9" Margin="0,0,2,0" VerticalAlignment="Bottom" Fill="#16301E" />
                                        <Rectangle x:Name="Wifi4" Width="5" Height="12" VerticalAlignment="Bottom" Fill="#16301E" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="TEMP" Style="{StaticResource TileLabel}" />
                                    <Border x:Name="TempBadge" CornerRadius="9" BorderThickness="1" Padding="5,1,6,1" Margin="0,3,0,0" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="TempBadgeDot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock x:Name="TempBadgeText" FontSize="10" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="CPU PHONE" Style="{StaticResource TileLabel}" />
                                    <TextBlock x:Name="CpuPhoneText" Text="-" Style="{StaticResource TileValue}" />
                                    <Grid x:Name="CpuPhoneBar" Height="6" Margin="0,3,0,0" Background="#06100A" BorderBrush="#1F3A26" BorderThickness="1" CornerRadius="3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="0*" /><ColumnDefinition Width="100*" /></Grid.ColumnDefinitions>
                                        <Border x:Name="CpuPhoneBarFill" Background="#39FF14" CornerRadius="2" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="CPU APP" Style="{StaticResource TileLabel}" />
                                    <TextBlock x:Name="CpuAppText" Text="-" Style="{StaticResource TileValue}" />
                                    <Grid x:Name="CpuAppBar" Height="6" Margin="0,3,0,0" Background="#06100A" BorderBrush="#1F3A26" BorderThickness="1" CornerRadius="3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="0*" /><ColumnDefinition Width="100*" /></Grid.ColumnDefinitions>
                                        <Border x:Name="CpuAppBarFill" Background="#39FF14" CornerRadius="2" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="MEMORY" Style="{StaticResource TileLabel}" />
                                    <TextBlock x:Name="MemText" Text="-" Style="{StaticResource TileValue}" />
                                    <Grid x:Name="MemBar" Height="6" Margin="0,3,0,0" Background="#06100A" BorderBrush="#1F3A26" BorderThickness="1" CornerRadius="3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="0*" /><ColumnDefinition Width="100*" /></Grid.ColumnDefinitions>
                                        <Border x:Name="MemBarFill" Background="#39FF14" CornerRadius="2" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="ENGINE" Style="{StaticResource TileLabel}" />
                                    <Border x:Name="EngBadge" CornerRadius="9" BorderThickness="1" Padding="5,1,6,1" Margin="0,3,0,0" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="EngBadgeDot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock x:Name="EngBadgeText" FontSize="10" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="LATENCY" Style="{StaticResource TileLabel}" />
                                    <TextBlock x:Name="LatText" Text="-" Style="{StaticResource TileValue}" />
                                    <Grid x:Name="LatBar" Height="6" Margin="0,3,0,0" Background="#06100A" BorderBrush="#1F3A26" BorderThickness="1" CornerRadius="3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="0*" /><ColumnDefinition Width="100*" /></Grid.ColumnDefinitions>
                                        <Border x:Name="LatBarFill" Background="#39FF14" CornerRadius="2" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock x:Name="PowerLabel" Text="POWER" Style="{StaticResource TileLabel}" />
                                    <TextBlock x:Name="PowerValText" Text="-" Style="{StaticResource TileValue}" />
                                    <Grid x:Name="PowerBar" Height="6" Margin="0,3,0,0" Background="#06100A" BorderBrush="#1F3A26" BorderThickness="1" CornerRadius="3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="0*" /><ColumnDefinition Width="100*" /></Grid.ColumnDefinitions>
                                        <Border x:Name="PowerBarFill" Background="#39FF14" CornerRadius="2" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <!-- Notices: same look as the web page. -->
                        <Border x:Name="LoginNotice" Visibility="Collapsed" BorderBrush="#7D6E2E" BorderThickness="3,1,1,1" CornerRadius="5" Background="#1A1808" Padding="8,5,8,5" Margin="0,8,0,0">
                            <TextBlock Text="Default login admin / admin in use. Change it under Network and login." FontSize="11" Foreground="#E8D8A0" TextWrapping="Wrap" />
                        </Border>
                        <Border x:Name="ChargerNoticeBorder" Visibility="Collapsed" BorderBrush="#7D6E2E" BorderThickness="3,1,1,1" CornerRadius="5" Background="#1A1808" Padding="8,5,8,5" Margin="0,6,0,0">
                            <TextBlock x:Name="ChargerNoticeText" Text="" FontSize="11" Foreground="#E8D8A0" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
                <!-- Service strip: the four ways in, grouped RTSP / WEB UI, each row Wi-Fi or USB with its full address. Green dot =
                     reachable, grey = not; the note on the right says why (viewers, stopped, no USB). Tap opens Network and login.
                     USB: the phone cannot see the cable as a link (IP over USB arrives as loopback), so USB is certain only once a
                     PC has connected; see UpdateServicePills. -->
                <StackPanel x:Name="ServiceStrip" Margin="0,0,0,6">
                    <Border Style="{StaticResource ServiceGroup}">
                        <StackPanel>
                            <TextBlock Text="RTSP" Style="{StaticResource ServiceGroupLabel}" />
                            <Border x:Name="SvcWifi" Style="{StaticResource ServicePill}" Tapped="ServicePill_Tapped">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Ellipse x:Name="SvcWifiDot" Style="{StaticResource PillDot}" />
                                    <TextBlock Grid.Column="1" Text="Wi-Fi" Style="{StaticResource PillLabel}" />
                                    <TextBlock x:Name="SvcWifiText" Grid.Column="2" Style="{StaticResource PillText}" Text="" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="SvcWifiNote" Grid.Column="3" Style="{StaticResource PillText}" Foreground="#7F9A86" Margin="6,0,0,0" Text="" />
                                </Grid>
                            </Border>
                            <Border x:Name="SvcUsb" Style="{StaticResource ServicePill}" Tapped="ServicePill_Tapped">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Ellipse x:Name="SvcUsbDot" Style="{StaticResource PillDot}" />
                                    <TextBlock Grid.Column="1" Text="USB" Style="{StaticResource PillLabel}" />
                                    <TextBlock x:Name="SvcUsbText" Grid.Column="2" Style="{StaticResource PillText}" Text="" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="SvcUsbNote" Grid.Column="3" Style="{StaticResource PillText}" Foreground="#7F9A86" Margin="6,0,0,0" Text="" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ServiceGroup}">
                        <StackPanel>
                            <TextBlock Text="WEB UI" Style="{StaticResource ServiceGroupLabel}" />
                            <Border x:Name="SvcWeb" Style="{StaticResource ServicePill}" Tapped="ServicePill_Tapped">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Ellipse x:Name="SvcWebDot" Style="{StaticResource PillDot}" />
                                    <TextBlock Grid.Column="1" Text="Wi-Fi" Style="{StaticResource PillLabel}" />
                                    <TextBlock x:Name="SvcWebText" Grid.Column="2" Style="{StaticResource PillText}" Text="" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="SvcWebNote" Grid.Column="3" Style="{StaticResource PillText}" Foreground="#7F9A86" Margin="6,0,0,0" Text="" />
                                </Grid>
                            </Border>
                            <Border x:Name="SvcWebUsb" Style="{StaticResource ServicePill}" Tapped="ServicePill_Tapped">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Ellipse x:Name="SvcWebUsbDot" Style="{StaticResource PillDot}" />
                                    <TextBlock Grid.Column="1" Text="USB" Style="{StaticResource PillLabel}" />
                                    <TextBlock x:Name="SvcWebUsbText" Grid.Column="2" Style="{StaticResource PillText}" Text="" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="SvcWebUsbNote" Grid.Column="3" Style="{StaticResource PillText}" Foreground="#7F9A86" Margin="6,0,0,0" Text="" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="AlertText" Text="" Foreground="#FF5555" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,4" />
                <!-- Safe mode (the MP4 engine after a crash or two stalls): the way back, as on the web page. -->
                <Button x:Name="NormalModeButton" Content="Return to normal mode (low-latency engine)" HorizontalAlignment="Stretch" Visibility="Collapsed"
                        Margin="0,2,0,4" Click="NormalModeButton_Click" Background="#3A1010" Foreground="#FFD0D0" BorderBrush="#A03030" />
                <!-- Preview and Screensaver, right under the status: light-bar buttons (MainPage.Display.cs). Preview shows the
                     live state of the picture, whatever started it; a press ends it, or shows it (60 s while the screensaver
                     runs, otherwise until pressed again). The two ToggleSwitches below hold the state and are never shown. -->
                <Button x:Name="PreviewButton" Style="{StaticResource BarButton}" Click="PreviewButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border x:Name="PreviewBar" Style="{StaticResource BarLight}" />
                        <TextBlock Grid.Column="1" Text="Preview" Style="{StaticResource BarName}" />
                        <TextBlock x:Name="PreviewStateText" Grid.Column="2" Text="OFF" Style="{StaticResource BarState}" />
                    </Grid>
                </Button>
                <Button x:Name="ScreensaverButton" Style="{StaticResource BarButton}" Click="ScreensaverButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border x:Name="ScreensaverBar" Style="{StaticResource BarLight}" />
                        <TextBlock Grid.Column="1" Text="Screensaver" Style="{StaticResource BarName}" />
                        <TextBlock x:Name="ScreensaverStateText" Grid.Column="2" Text="ON" Style="{StaticResource BarState}" />
                    </Grid>
                </Button>
                <!-- Flashlight: only while streaming, 30 s at a time (the LED heats the phone); the hidden switch below holds the state. -->
                <Button x:Name="TorchButton" Style="{StaticResource BarButton}" Click="TorchButton_Click" IsEnabled="False">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border x:Name="TorchBar" Style="{StaticResource BarLight}" />
                        <TextBlock Grid.Column="1" Text="Flashlight" Style="{StaticResource BarName}" />
                        <TextBlock x:Name="TorchStateText" Grid.Column="2" Text="OFF" Style="{StaticResource BarState}" />
                    </Grid>
                </Button>
                <StackPanel Visibility="Collapsed">
                    <ToggleSwitch x:Name="PreviewToggle" Toggled="PreviewToggle_Toggled" />
                    <ToggleSwitch x:Name="PowerSaveToggle" IsOn="True" Toggled="PowerSaveToggle_Toggled" />
                    <TextBlock x:Name="TorchAlert" Text="Heat protection: flashlight locked" Visibility="Collapsed" />
                    <ToggleSwitch x:Name="TorchToggle" Header="Flashlight" IsOn="False" Toggled="TorchToggle_Toggled" />
                    <TextBlock x:Name="TorchNote" Text="" />
                </StackPanel>

                <Button Style="{StaticResource FoldButton}" Tag="VideoPanel|VIDEO" Content="VIDEO  &#x25B8;" Click="Fold_Click" />
                <StackPanel x:Name="VideoPanel" Visibility="Collapsed">
                    <TextBlock x:Name="VideoAlert" Text="Heat protection: 1080p / 6 Mbps" Foreground="#FF5555" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,2,0,2" />
                    <ComboBox x:Name="ResolutionBox" Header="Resolution" SelectionChanged="Setting_Changed" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                    <ComboBox x:Name="BitrateBox" Header="Bitrate" SelectionChanged="Setting_Changed" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                    <Grid>
                        <ToggleSwitch x:Name="HighBwToggle" Header="High bandwidth (over 24 Mbps)" IsOn="False" Toggled="HighBwToggle_Toggled" />
                        <Button Style="{StaticResource InfoButton}"><Button.Flyout><Flyout><TextBlock Style="{StaticResource InfoText}"
                            Text="Unlocks bitrates up to 60 Mbps. Needs 5 GHz Wi-Fi or USB; 2.4 GHz drops frames." /></Flyout></Button.Flyout></Button>
                    </Grid>
                    <ComboBox x:Name="KeyframeBox" Header="Keyframe every" SelectionChanged="Setting_Changed" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                    <ToggleSwitch x:Name="AudioToggle" Header="Microphone audio (AAC)" IsOn="False" Toggled="AudioToggle_Toggled" />
                </StackPanel>

                <Button Style="{StaticResource FoldButton}" Tag="CameraPanel|CAMERA" Content="CAMERA  &#x25B8;" Click="Fold_Click" />
                <StackPanel x:Name="CameraPanel" Visibility="Collapsed">
                    <ToggleSwitch x:Name="AutoCameraCheck" Header="Automatic focus, exposure and white balance" IsOn="True" Toggled="AutoCameraCheck_Changed" />
                    <Button x:Name="FocusOnceButton" Content="Focus once and lock" Click="FocusOnceButton_Click" HorizontalAlignment="Stretch" Margin="0,2,0,4" />
                    <TextBlock x:Name="TuningStateText" Text="" FontSize="11" Foreground="#B9CFBD" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <!-- Shown while at least one setting is manual. Each row: label + its own Auto box, then the slider
                         (greyed out while that setting is automatic). All three on Auto hides this panel again. -->
                    <StackPanel x:Name="ManualCameraPanel">
                        <!-- Each setting: its value as a label, Auto / Manual, then the slider (greyed out on Auto). As in W10MDashcam / W10MWebCam. -->
                        <TextBlock x:Name="FocusLabel" Text="Focus" FontSize="12" Margin="0,4,0,0" />
                        <ToggleSwitch x:Name="FocusAutoCheck" OnContent="Auto" OffContent="Manual" Toggled="SubAuto_Changed" Margin="0,-6,0,-6" />
                        <Slider x:Name="FocusSlider" Minimum="0" Maximum="100" StepFrequency="1" Margin="0,-6,0,0" ValueChanged="TuningSlider_ValueChanged" />
                        <TextBlock x:Name="ExposureLabel" Text="Exposure" FontSize="12" />
                        <ToggleSwitch x:Name="ExposureAutoCheck" OnContent="Auto" OffContent="Manual" Toggled="SubAuto_Changed" Margin="0,-6,0,-6" />
                        <Slider x:Name="ExposureSlider" Minimum="0" Maximum="100" StepFrequency="0.5" Margin="0,-6,0,0" ValueChanged="TuningSlider_ValueChanged" />
                        <TextBlock x:Name="WbLabel" Text="White balance" FontSize="12" />
                        <ToggleSwitch x:Name="WbAutoCheck" OnContent="Auto" OffContent="Manual" Toggled="SubAuto_Changed" Margin="0,-6,0,-6" />
                        <Slider x:Name="WbSlider" Minimum="2000" Maximum="8000" StepFrequency="100" Margin="0,-6,0,0" ValueChanged="TuningSlider_ValueChanged" />
                    </StackPanel>
                </StackPanel>

                <Button Style="{StaticResource FoldButton}" Tag="PowerPanel|POWER" Content="POWER  &#x25B8;" Click="Fold_Click" />
                <StackPanel x:Name="PowerPanel" Visibility="Collapsed">
                    <Grid>
                        <ToggleSwitch x:Name="HeatProtectToggle" Header="Heat protection" IsOn="True" Toggled="HeatProtectToggle_Toggled" />
                        <Button Style="{StaticResource InfoButton}"><Button.Flyout><Flyout><TextBlock Style="{StaticResource InfoText}"
                            Text="When charging pauses on a good charger the phone is hot: 1080p / 6 Mbps, screensaver on, flashlight locked, until it charges normally again. Off: nothing is changed, and on a weak charger the battery drains and the phone dies." /></Flyout></Button.Flyout></Button>
                    </Grid>
                    <TextBlock x:Name="PowerAlert" Text="Heat protection: power saving forced on" Foreground="#FF5555" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,2,0,2" />
                    <Grid>
                        <ToggleSwitch x:Name="KeepPreviewToggle" Header="Keep the preview running behind the black screen" Toggled="KeepPreviewToggle_Toggled" />
                        <Button Style="{StaticResource InfoButton}"><Button.Flyout><Flyout><TextBlock Style="{StaticResource InfoText}"
                            Text="A tap on the black screen then shows the picture at once. Costs CPU and heat; heat protection switches it off." /></Flyout></Button.Flyout></Button>
                    </Grid>
                    <Grid>
                        <ToggleSwitch x:Name="SaveAllCheck" Header="Power-saving camera features" IsOn="True" Toggled="SaveAll_Changed" />
                        <Button Style="{StaticResource InfoButton}"><Button.Flyout><Flyout><TextBlock Style="{StaticResource InfoText}"
                            Text="Stabilization off and focus held once it settles: less processing and heat on a fixed mount. Off: choose each one." /></Flyout></Button.Flyout></Button>
                    </Grid>
                    <StackPanel x:Name="SavePanel" Visibility="Collapsed" Margin="14,0,0,4">
                        <ToggleSwitch x:Name="SaveOisCheck" Header="Stabilization off (fixed mount)" Toggled="SaveSub_Changed" />
                        <ToggleSwitch x:Name="SaveFocusCheck" Header="Hold focus once it has settled" Toggled="SaveSub_Changed" />
                    </StackPanel>
                </StackPanel>

                <Button x:Name="NetworkFold" Style="{StaticResource FoldButton}" Tag="NetworkPanel|NETWORK AND LOGIN" Content="NETWORK AND LOGIN  &#x25B8;" Click="Fold_Click" />
                <StackPanel x:Name="NetworkPanel" Visibility="Collapsed">
                    <TextBlock Text="RTSP address (NVR / VLC):" Foreground="#7F9A86" FontSize="12" />
                    <TextBlock x:Name="AddressText" Text="…" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid>
                        <ToggleSwitch x:Name="WebServerToggle" Header="Web page (settings and status)" IsOn="True" Toggled="WebServerToggle_Toggled" />
                        <Button Style="{StaticResource InfoButton}"><Button.Flyout><Flyout><TextBlock Style="{StaticResource InfoText}"
                            Text="The settings page in a browser on the same Wi-Fi or over USB; readable without the login, changes need it. Off: only the stream is served." /></Flyout></Button.Flyout></Button>
                    </Grid>
                    <TextBlock x:Name="WebAddressText" Text="…" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8" />
                    <Grid>
                        <ToggleSwitch x:Name="LogServerToggle" Header="Log page (/log)" IsOn="False" Toggled="LogServerToggle_Toggled" />
                        <Button Style="{StaticResource InfoButton}"><Button.Flyout><Flyout><TextBlock Style="{StaticResource InfoText}"
                            Text="The app's log in a browser (needs the web page on)." /></Flyout></Button.Flyout></Button>
                    </Grid>
                    <Grid>
                        <ToggleSwitch x:Name="StatsServerToggle" Header="Stats page (/stats)" IsOn="False" Toggled="StatsServerToggle_Toggled" />
                        <Button Style="{StaticResource InfoButton}"><Button.Flyout><Flyout><TextBlock Style="{StaticResource InfoText}"
                            Text="Graphs of the last 12 hours (frame rate, battery, power, CPU, memory, heat), sampled every 30 s while on." /></Flyout></Button.Flyout></Button>
                    </Grid>
                    <ToggleSwitch x:Name="AutoStartToggle" Header="Start streaming when the app opens" IsOn="True" Toggled="AutoStartToggle_Toggled" />
                    <Grid>
                        <ToggleSwitch x:Name="UdpToggle" Header="Allow RTP over UDP" IsOn="False" Toggled="UdpToggle_Toggled" />
                        <Button Style="{StaticResource InfoButton}"><Button.Flyout><Flyout><TextBlock Style="{StaticResource InfoText}"
                            Text="Off: viewers get the stream over TCP, which is more reliable on Wi-Fi." /></Flyout></Button.Flyout></Button>
                    </Grid>
                    <ToggleSwitch x:Name="SnapshotToggle" Header="Snapshots at /snapshot.jpg" IsOn="False" Toggled="SnapshotToggle_Toggled" />
                    <TextBlock Text="Login (stream and web page)" Foreground="#7F9A86" FontSize="12" Margin="0,8,0,0" />
                    <TextBlock x:Name="LoginStatusText" Text="" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBox x:Name="UserBox" PlaceholderText="User name (admin)" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PassBox" PlaceholderText="New password (empty = reset to admin)" Margin="0,0,0,4" />
                    <Button x:Name="SaveLoginButton" Content="Save login" HorizontalAlignment="Stretch" Click="SaveLoginButton_Click" Margin="0,0,0,6" />
                </StackPanel>

                <Button Style="{StaticResource FoldButton}" Tag="DetailsPanel|DETAILS AND LOG" Content="DETAILS AND LOG  &#x25B8;" Click="Fold_Click" />
                <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
                    <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="LightGray" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock x:Name="LogText" FontSize="11" TextWrapping="Wrap" Foreground="#B9CFBD"
                               IsTextSelectionEnabled="True" FontFamily="Consolas" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Full black overlay: on an OLED screen black pixels are off, so this costs almost no power and avoids burn-in. -->
        <Border x:Name="BlackoutOverlay" Grid.ColumnSpan="2" Background="Black" Visibility="Collapsed" Tapped="BlackoutOverlay_Tapped">
            <TextBlock Text="Streaming - tap to show controls" Foreground="#222" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
        </Border>
    </Grid>
</Page>
